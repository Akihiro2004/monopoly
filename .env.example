# ------------------------------------------------------------------
# TMpoly configuration. Copy this file to `.env` (same folder) and fill in
# what you need. Everything is optional: with no .env the game runs as
# before (guest players, games saved to server/data/).
# ------------------------------------------------------------------

# --- Server --------------------------------------------------------
# Port the game server listens on.
PORT=5000

# Running games are saved on this server so they survive a restart /
# redeploy (players come back into their match automatically).
# Default: server/data/rooms
# ROOMS_DIR=./server/data/rooms

# Set to "off" to keep rooms in memory only (nothing saved).
# PERSIST=off

# --- Firebase (player accounts + leaderboard stats) -----------------
# The game itself runs on this server and client; Firebase only knows the
# players, and is kept light for the free (Spark) plan:
#   * Authentication (free): every player gets a guest account
#     automatically; "Sign in with Google" upgrades it so the same player,
#     stats and running games follow them to any device.
#   * Firestore: one small document per player in `players`
#     ({ name, wins, gamesPlayed, bestScore }). It is written once per
#     player when a game ends, and the leaderboard is read at most once
#     every 5 minutes (server cache). Running games never go to Firestore.
# Without these values the leaderboard uses a local history file instead.
#
# Setup (Firebase console, https://console.firebase.google.com):
#   1. Create a project.
#   2. Build > Authentication > Get started, then enable the providers
#      "Anonymous" and "Google". Under Settings > Authorized domains add the
#      domain you play on (localhost is there already).
#   3. Build > Firestore Database > Create database (production mode).
#      Deploy the rules in firestore.rules (clients never touch Firestore
#      directly; the server does).
#   4. Project settings > General > Your apps > Add app > Web: copy the
#      config values into the VITE_FIREBASE_* lines below.
#   5. Project settings > Service accounts > Generate new private key:
#      put the JSON on ONE line (or base64 of it) in FIREBASE_SERVICE_ACCOUNT,
#      or save the file and point GOOGLE_APPLICATION_CREDENTIALS at it.
#      Keep this key secret: never commit it.

# Client (public web config, safe to ship in the browser bundle)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Server (secret): the service account JSON, raw on one line or base64.
FIREBASE_SERVICE_ACCOUNT=
# ...or a path to the JSON file instead:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
