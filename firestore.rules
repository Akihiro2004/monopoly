rules_version = '2';
// TMpoly: only the game server (Admin SDK, which bypasses these rules)
// reads and writes Firestore. Browsers sign in with Firebase Auth but never
// access the database directly, so every client request is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
